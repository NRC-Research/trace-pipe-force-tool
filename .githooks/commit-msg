#!/usr/bin/env bash
# Rejects commit messages that attribute work to AI tooling, per the SOC audit
# requirement. Violations otherwise require history rewrites to correct.
#
# Scope is deliberately narrow: this checks the COMMIT MESSAGE only, never file
# content. The repository's documentation legitimately discusses AI tooling as
# subject matter; that is not what this guards against.
#
# Install with: scripts/install-hooks.sh

set -uo pipefail

msg_file="$1"
# Scan the file verbatim, comments included. Git strips '#' lines only for
# editor-based commits (cleanup=strip); with -m/-F the default cleanup is
# 'whitespace', and with cleanup=verbatim they are always kept -- so a
# '#'-prefixed attribution (e.g. a markdown heading) would reach the recorded
# history unchecked if we stripped here. A command-line --cleanup= override is
# invisible to this hook, so mode detection is unsound; scanning everything is
# the only safe canonicalization. Git's own template mentions nothing that
# matches the patterns below. The rare cost: a commented-out attribution in an
# editor session is blocked even though git would strip it -- delete the line
# to proceed. Blocking is the safe direction.
msg=$(cat -- "$msg_file" || true)

# Attribution patterns, not mere mentions.
patterns=(
  'Co-Authored-By:[[:space:]]*Claude'
  'Co-Authored-By:[[:space:]]*.*anthropic'
  'Generated with'
  'Co-authored-by:[[:space:]]*Copilot'
  '🤖'
)

failed=0
for p in "${patterns[@]}"; do
  if printf '%s' "$msg" | grep -qiE "$p"; then
    echo "commit-msg: message matches prohibited attribution pattern: $p" >&2
    failed=1
  fi
done

if [ "$failed" -ne 0 ]; then
  echo "" >&2
  echo "Commit blocked: commit messages must not attribute work to AI tooling." >&2
  echo "Describe what changed and why. Do not use --no-verify to bypass this." >&2
  exit 1
fi

exit 0
